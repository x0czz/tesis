// Esquema de hipótesis (versión noviembre 2026)
// Renderizar: dot -Tsvg esquema_hipotesis.dot -o esquema_hipotesis.svg
//             dot -Tpng -Gdpi=200 esquema_hipotesis.dot -o esquema_hipotesis.png
digraph hipotesis {
  graph [rankdir=LR, splines=true, nodesep=0.22, ranksep=1.5, fontname="Helvetica", bgcolor="white", pad=0.3,
         label=<<FONT POINT-SIZE="11" COLOR="#555555">Logit ordinal multinivel: observaciones (nivel 1) en estudiantes (nivel 2). Cada predictor se separa en efectos within, between y contextual.<BR/>Panel EDUMER, dos olas (2023–2024).</FONT>>, labelloc=b, labeljust=l];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#BDBDBD", fillcolor="white", penwidth=1.2, margin="0.15,0.07"];
  edge  [fontname="Helvetica", fontsize=13, penwidth=1.6, arrowsize=0.8];

  subgraph cluster_escuela {
    label="Experiencia escolar"; fontsize=12; fontcolor="#4A4A4A"; style="rounded"; color="#DDDDDD";
    h1 [label=<<B>H1</B>  Meritocracia escolar percibida<BR/><FONT POINT-SIZE="10" COLOR="#777777">"obtienen las notas que merecen" (p2_3)</FONT>>];
  }
  subgraph cluster_posicion {
    label="Posición escolar y horizonte"; fontsize=12; fontcolor="#4A4A4A"; style="rounded"; color="#DDDDDD";
    h2 [label=<<B>H2</B>  Promedio de notas<BR/><FONT POINT-SIZE="10" COLOR="#777777">p4, escala 1,0–7,0</FONT>>];
    h3 [label=<<B>H3</B>  Expectativa universitaria<BR/><FONT POINT-SIZE="10" COLOR="#777777">p25, universidad vs. resto</FONT>>];
  }
  subgraph cluster_trayectoria {
    label="Trayectoria escolar"; fontsize=12; fontcolor="#4A4A4A"; style="rounded"; color="#DDDDDD";
    h4 [label=<<B>H4</B>  Segunda ola<BR/><FONT POINT-SIZE="10" COLOR="#777777">internalización (+) / ilustración (−)</FONT>>];
  }
  subgraph cluster_creencias {
    label="Creencias meritocráticas (Castillo et al., 2023; Laffert et al., 2026)"; fontsize=12; fontcolor="#4A4A4A"; style="rounded"; color="#DDDDDD";
    h5a [label=<<B>H5a</B>  Percepción de meritocracia<BR/><FONT POINT-SIZE="10" COLOR="#777777">p1_1, p1_2</FONT>>];
    h5b [label=<<B>H5b</B>  Percepción de privilegio<BR/><FONT POINT-SIZE="10" COLOR="#777777">p1_3, p1_4</FONT>>];
    h5c [label=<<B>H5c</B>  Preferencia meritocrática<BR/><FONT POINT-SIZE="10" COLOR="#777777">p1_5, p1_6 · exploratoria</FONT>>, style="rounded,filled,dashed"];
    h5d [label=<<B>H5d</B>  Aceptación del privilegio<BR/><FONT POINT-SIZE="10" COLOR="#777777">p1_7, p1_8 · exploratoria</FONT>>, style="rounded,filled,dashed"];
  }

  vd [label=<<B>Percepción de igualdad<BR/>de oportunidades</B><BR/><FONT POINT-SIZE="10">"En Chile, todas las personas tienen las mismas<BR/>oportunidades para salir adelante" (p1_9)</FONT>>,
      fillcolor="#99000D", fontcolor="white", color="#99000D", fontsize=13, margin="0.25,0.15"];

  ctrl [label=<<B>Controles</B><BR/><FONT POINT-SIZE="10">Género · País de nacimiento · Cohorte (media vs. básica)</FONT>>, fillcolor="#F1EFEC", color="#BDBDBD"];

  h1  -> vd [label="+", color="#99000D", fontcolor="#99000D"];
  h2  -> vd [label="+", color="#99000D", fontcolor="#99000D"];
  h3  -> vd [label="+", color="#99000D", fontcolor="#99000D"];
  h4  -> vd [label="±", color="#4A4A4A", fontcolor="#4A4A4A", style=dashed];
  h5a -> vd [label="+", color="#99000D", fontcolor="#99000D"];
  h5b -> vd [label="−", color="#4A4A4A", fontcolor="#4A4A4A"];
  h5c -> vd [label="?", color="#9E9E9E", fontcolor="#777777", style=dotted];
  h5d -> vd [label="?", color="#9E9E9E", fontcolor="#777777", style=dotted];
  ctrl -> vd [color="#BDBDBD", style=dashed, arrowhead=none];

  { rank=same; vd; }
}
