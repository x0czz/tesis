@article{dickinson_adolescent_1990,
  title = {Adolescent Representations of Socio-economic Status},
  author = {Dickinson, Julie},
  year = 1990,
  month = nov,
  journal = {British Journal of Developmental Psychology},
  volume = {8},
  number = {4},
  pages = {351--371},
  issn = {0261-510X, 2044-835X},
  doi = {10.1111/j.2044-835X.1990.tb00850.x},
  urldate = {2026-08-30},
  abstract = {The development of beliefs about the nature, causes and fairness of occupational prestige and income differentials, in subjects aged 10 to 16 years, was studied in relation to age and social class. Slight but stable age and class differences were found in perceptions of socio-economic inequality and the kind of explanations postulated for inequality. Open-ended questions produced a wide variety of explanations for prestige and income differentials but the reasons most commonly employed by all age and class groups were the `importance' or `social contribution' of the job, the `effort exerted' doing the job and the `education' or `training' needed. Strong and stable class effects and some age effects were found in the use of references to `education' or `training'. Judgements of the fairness of inequality were subject to class effects but largely unaffected by age. The results are discussed in relation to cognitive developmental theory and the role of social influence and socially transmitted information in the construction of socio-economic beliefs.},
  copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
  langid = {english}
}

@article{ekman_political_2012,
  title = {Political Participation and Civic Engagement: {{Towards}} a New Typology},
  shorttitle = {Political Participation and Civic Engagement},
