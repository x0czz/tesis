@article{thompson_ethical_2021,
  title = {Ethical Considerations and Challenges for Using Digital Ethnography to Research Vulnerable Populations},
  author = {Thompson, Alex and Stringfellow, Lindsay and Maclean, Mairi and Nazzal, Amal},
