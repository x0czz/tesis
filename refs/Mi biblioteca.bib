@article{urbiola_believing_2025,
  title = {Believing That Social Change Is Possible: {{Collective}} Efficacy to Promote Engagement and Mobilization of non-{{Roma}} as Allies},
  shorttitle = {Believing That Social Change Is Possible},
  author = {Urbiola, Ana and L{\'o}pez-Rodr{\'i}guez, Luc{\'i}a and Torres-Vega, Laura C. and Poslon, Xenia-Daniela and L{\'a}{\v s}ticov{\'a}, Barbara and P{\'a}ntya, J{\'o}zsef and Szekeres, Hanna and Kende, Anna},
  year = 2025,
