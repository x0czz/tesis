@article{portilho_consumo_2005,
  title = {{Consumo sustent\'avel: limites e possibilidades de ambientaliza\c c\~ao e politiza\c c\~ao das pr\'aticas de consumo}},
  shorttitle = {{Consumo sustent\'avel}},
  author = {Portilho, F{\'a}tima},
